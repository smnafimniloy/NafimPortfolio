{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/fetch-github.js",
    "build": "node scripts/fetch-github.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/postbuild.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:design": "designmd lint DESIGN.md",
    "check": "npm run lint && npm run lint:design && npm run build"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "marked": "^18.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22"
  }
